---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import LearningLog from '../../components/LearningLog.astro';
import OpenSource from '../../components/OpenSource.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const sections = [
  { id: 'learning-log', label: 'Learning log' },
  { id: 'open-source', label: 'Open source' },
  { id: 'posts', label: 'Posts' },
];
---
<Base title="Blog">
  <Hero page="blog" />

  <nav class="section-nav" aria-label="Page sections">
    {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
  </nav>

  <section id="learning-log" class="section">
    <p class="section-title">Learning log</p>
    <LearningLog />
  </section>

  <section id="open-source" class="section">
    <p class="section-title">Open source</p>
    <OpenSource />
  </section>

  <section id="posts" class="section">
    <p class="section-title">Posts</p>
    {posts.length > 0 ? (
      <ul class="post-list" id="post-list">
        {posts.map((post) => (
          <li class="post-item" data-slug={post.id}>
            <span class="post-date">{formatDate(post.data.date)}</span>
            <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
            <span class="unread-dot" hidden aria-label="Unread"></span>
            <ShareButton url={`/blog/${post.id}`} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">No posts yet.</p>
    )}
  </section>
</Base>

<script>
  // Mark unread posts with a dot. Runs client-side so it's per-device.
  try {
    const read: string[] = JSON.parse(localStorage.getItem('read_posts') || '[]');
    document.querySelectorAll<HTMLElement>('#post-list .post-item').forEach(item => {
      const slug = item.dataset.slug ?? '';
      if (!read.includes(slug)) {
        const dot = item.querySelector<HTMLElement>('.unread-dot');
        if (dot) dot.hidden = false;
      }
    });
  } catch {}
</script>

<script>
  // Scrollspy: highlight the section nav link for whichever section is in view.
  // Progressive enhancement — without JS the links still work as anchor jumps.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.section-nav a'));
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') || ''))
    .filter((el): el is HTMLElement => el !== null);
  function setActive(href: string) {
    links.forEach((l) => {
      const match = l.getAttribute('href') === href;
      l.classList.toggle('active', match);
      if (match) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    });
  }
  if (targets.length) {
    setActive(links[0].getAttribute('href') || ''); // seed so the top of the page isn't unhighlighted
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(`#${e.target.id}`);
        });
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    );
    targets.forEach((t) => obs.observe(t));
  }
</script>
