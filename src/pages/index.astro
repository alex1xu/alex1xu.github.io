---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<Base>
  <section class="intro">
    <h1>Alex Xu</h1>
    <p>
      Software engineer at Databricks. I work on distributed systems and storage.
      This is where I write about things I'm learning.
    </p>
    <div class="intro-links">
      <a href="https://github.com/alex1xu">GitHub</a>
      <a href="https://linkedin.com/in/alex1xu">LinkedIn</a>
      <a href="mailto:a.xu@databricks.com">Email</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <p class="section-title">Recent writing</p>
      <ul class="post-list">
        {posts.map(post => (
          <li class="post-item">
            <span class="post-date">{formatDate(post.data.date)}</span>
            <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
