---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const experience = [
  { role: 'Software Engineer Intern', org: 'Databricks', meta: 'May 2026 – Aug 2026', logo: '/logos/databricks_logo.jpeg' },
  { role: 'Software Engineer Intern', org: 'Annapurna Labs', meta: 'Sep 2025 – Dec 2025', logo: '/logos/annapurna_labs_logo.jpeg' },
  { role: 'Software Engineer Intern', org: 'Roblox', meta: 'May 2025 – Aug 2025', logo: '/logos/roblox_logo.jpeg' },
  {
    role: 'Researcher',
    org: 'Albert Einstein College of Medicine',
    meta: 'Apr 2022 – Sep 2024',
    logo: '/logos/einstein_logo.jpeg',
    paper: 'https://pubmed.ncbi.nlm.nih.gov/37295808/',
  },
  { role: 'Emergency Medical Technician', org: 'Manhasset-Lakeville Fire Department', meta: 'Jan 2023 – Aug 2024', logo: '/logos/ambulance_logo.jpg' },
];

const courses = [
  ['CS 162', 'Operating Systems'],
  ['CS 164', 'Compilers'],
  ['CS 168', 'Internet Architecture'],
  ['CS 152', 'Computer Architecture & Engineering'],
  ['CS 186', 'Database Systems'],
  ['EECS 151', 'Digital Design & ICs (ASIC Lab)'],
  ['CS 61C', 'Machine Structures'],
  ['CS 161', 'Computer Security'],
  ['CS 170', 'Efficient Algorithms'],
  ['EECS 127', 'Optimization Models'],
  ['CS 61B', 'Data Structures'],
  ['CS 61A', 'Computer Programming'],
  ['CS 70', 'Discrete Math & Probability'],
  ['Math 56', 'Linear Algebra'],
  ['Math 53', 'Multivariable Calculus'],
  ['Data 8', 'Data Science Foundations'],
];
---
<Base>
  <Hero page="home" />

  <section class="section">
    <p class="section-title">Experience</p>
    <ul class="exp-list">
      {experience.map((e) => (
        <li class="exp-item">
          <img class="exp-logo" src={e.logo} alt={`${e.org} logo`} width="40" height="40" loading="lazy" />
          <div class="exp-body">
            <span class="exp-role">{e.role} · <span class="exp-org">{e.org}</span></span>
            <span class="exp-meta">{e.meta}</span>
            {e.desc && <span class="exp-note">{e.desc}</span>}
            {e.paper && (
              <a class="exp-link" href={e.paper} target="_blank" rel="noopener noreferrer">
                Read the paper (co-first author) →
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <p class="section-title">Education</p>
    <ul class="exp-list">
      <li class="exp-item">
        <img class="exp-logo" src="/logos/uc_berkeley_logo.jpeg" alt="UC Berkeley logo" width="40" height="40" loading="lazy" />
        <div class="exp-body">
          <span class="exp-role">University of California, Berkeley</span>
          <span class="exp-meta">B.A. Computer Science · 2024–2026 · GPA 4.0/4.0</span>
          <span class="exp-note">Traders at Berkeley — Head of Game Development, 2026 Berkeley Trading Competition</span>
          <span class="exp-note">Student Association for Applied Statistics — Project Manager</span>
        </div>
      </li>
    </ul>
    <p class="course-label">Relevant coursework</p>
    <ul class="course-tags">
      {courses.map(([code, name]) => (
        <li class="course"><span class="course-code">{code}</span> {name}</li>
      ))}
    </ul>
  </section>
</Base>
