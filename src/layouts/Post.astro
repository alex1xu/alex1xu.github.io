---
import Base from './Base.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
}

const { title, date, description, tags } = Astro.props;
const formatted = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<Base title={title} description={description}>
  <a href="/blog" class="back-link">← Blog</a>
  <article class="prose">
    <h1>{title}</h1>
    <div class="post-meta">
      <span>{formatted}</span>
      {tags && tags.length > 0 && (
        <span>{tags.join(', ')}</span>
      )}
    </div>
    <slot />
  </article>
</Base>
