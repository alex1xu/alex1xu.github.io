---
import { learning, type LearningEntry, type Status } from '../data/learning';

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

const sorted = [...learning].sort((a, b) => (a.date < b.date ? -1 : 1));

// date string → entries on that day
const byDate = new Map<string, LearningEntry[]>();
for (const e of sorted) {
  const list = byDate.get(e.date) ?? [];
  list.push(e);
  byDate.set(e.date, list);
}

function fmtListDate(date: string) {
  const [y, m, d] = date.split('-').map(Number);
  return `${MONTH_NAMES[m - 1].slice(0, 3)} ${d}`;
}

function statusLabel(s: Status) {
  return s === 'done' ? 'Done' : s === 'next' ? 'Up next' : 'Planned';
}

// Representative status for a day cell (prioritise what needs attention).
function cellStatus(entries: LearningEntry[]): Status {
  if (entries.some((e) => e.status === 'next')) return 'next';
  if (entries.some((e) => e.status === 'planned')) return 'planned';
  return 'done';
}

// Build the set of months spanned by the entries, each with its day grid.
type MonthGrid = { key: string; label: string; cells: (number | null)[] };
const monthKeys = [...new Set(sorted.map((e) => e.date.slice(0, 7)))].sort();
const months: MonthGrid[] = monthKeys.map((key) => {
  const [y, m] = key.split('-').map(Number);
  const firstWeekday = new Date(y, m - 1, 1).getDay();
  const daysInMonth = new Date(y, m, 0).getDate();
  const cells: (number | null)[] = [];
  for (let i = 0; i < firstWeekday; i++) cells.push(null);
  for (let d = 1; d <= daysInMonth; d++) cells.push(d);
  return { key, label: `${MONTH_NAMES[m - 1]} ${y}`, cells };
});

function cellDate(monthKey: string, day: number) {
  return `${monthKey}-${String(day).padStart(2, '0')}`;
}
---
<div class="cal">
  <input class="cal-radio" type="radio" name="calview" id="view-list" checked />
  <input class="cal-radio" type="radio" name="calview" id="view-month" />

  <div class="cal-bar">
    <div class="cal-tabs">
      <label for="view-list">List</label>
      <label for="view-month">Calendar</label>
    </div>
    <div class="cal-legend">
      <span><i class="dot done"></i>Done</span>
      <span><i class="dot next"></i>Up next</span>
      <span><i class="dot planned"></i>Planned</span>
    </div>
  </div>

  <!-- List view -->
  <div class="cal-list">
    <ol>
      {sorted.map((e) => (
        <li class:list={['cal-entry', { 'is-next': e.status === 'next' }]}>
          <div class="cal-entry-date">{fmtListDate(e.date)}</div>
          <div class="cal-entry-body">
            <div class="cal-entry-head">
              <i class:list={['dot', e.status]} title={statusLabel(e.status)}></i>
              <span class="cal-entry-title">{e.title}</span>
            </div>
            <ul class="cal-items">
              {e.items.map((it) => <li>{it}</li>)}
            </ul>
            {e.blog && (
              <a class="cal-entry-link" href={`/blog/${e.blog}`}>Read the write-up →</a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>

  <!-- Month view -->
  <div class="cal-month">
    {months.map((mo) => (
      <div class="cal-month-block">
        <div class="cal-month-label">{mo.label}</div>
        <div class="cal-grid">
          {WEEKDAYS.map((w) => <div class="cal-weekday">{w}</div>)}
          {mo.cells.map((day) => {
            if (day === null) return <div class="cal-cell empty"></div>;
            const entries = byDate.get(cellDate(mo.key, day));
            if (!entries) {
              return (
                <div class="cal-cell">
                  <span class="day-num">{day}</span>
                </div>
              );
            }
            const s = cellStatus(entries);
            return (
              <div
                class={`cal-cell has-entry s-${s}`}
                title={entries.map((e) => e.title).join(' · ')}
              >
                <span class="day-num"><i class:list={['dot', s]}></i>{day}</span>
                <span class="cell-label">{entries.map((e) => e.title).join(' · ')}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>
