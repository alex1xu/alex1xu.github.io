---
// Bid-side price ladder as a bounded array (1–99¢). Each cent is an index into an array of FIFO
// queues of resting orders. The best-bid cursor does a bounded backward scan.
// Show a representative window of the 99 slots with a few populated.
const slots = [
  { cent: 1, orders: 0 },
  { cent: 2, orders: 0 },
  { cent: 3, orders: 2 },
  { cent: 4, orders: 3 },
  { cent: 5, orders: 1 },
  { cent: 6, orders: 0 },
  { cent: 7, orders: 0 },
  { cent: 8, orders: 0 },
];
const best = 5; // highest populated bid in this window
const W = 640, colW = 74, x0 = 40, top = 58, cellH = 22, gap = 4, maxQ = 3;
const H = top + maxQ * (cellH + gap) + 74;
const cx = (i) => x0 + i * colW;
const slotW = colW - 12;
const bestIdx = slots.findIndex((s) => s.cent === best);
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bid-side price ladder as an array. Each cent from 1 to 99 indexes a FIFO queue of resting buy orders. Access to a level is constant time. The best bid is the highest populated price; if it empties, the cursor scans backward through at most 99 slots. Shown: bids at 3, 4, and 5 cents.">
    <text x={x0 - 8} y={top - 24} text-anchor="start" class="axttl">bid_price[cent] → FIFO queue of resting orders</text>

    {/* best-price cursor */}
    <g>
      <line x1={cx(bestIdx) + slotW / 2} y1={top - 16} x2={cx(bestIdx) + slotW / 2} y2={top - 4} stroke="var(--accent)" stroke-width="1.5" />
      <text x={cx(bestIdx) + slotW / 2} y={top - 20} text-anchor="middle" class="cursor">best bid ↓</text>
    </g>
    {/* bounded backward scan arrow: from a higher empty slot down toward best */}
    <line x1={cx(bestIdx + 2) + slotW / 2} y1={top - 10} x2={cx(bestIdx) + slotW / 2 + 6} y2={top - 10} stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="3 2" marker-end="url(#al-arr)" />
    <text x={cx(bestIdx + 1) + slotW / 2 + 8} y={top - 14} text-anchor="middle" class="scan">bounded backward scan</text>

    <defs>
      <marker id="al-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="var(--accent)" /></marker>
    </defs>

    {slots.map((s, i) => {
      const isBest = s.cent === best;
      return (
        <g>
          {/* index axis label */}
          <text x={cx(i) + slotW / 2} y={top + maxQ * (cellH + gap) + 18} text-anchor="middle" class={`cent${isBest ? ' best' : ''}`}>{s.cent}¢</text>
          {/* the slot column (queue cells, drawn bottom-up = FIFO front at bottom) */}
          {Array.from({ length: maxQ }).map((_, r) => {
            const filled = r < s.orders;
            const y = top + (maxQ - 1 - r) * (cellH + gap);
            return (
              <rect x={cx(i)} y={y} width={slotW} height={cellH} rx="3"
                fill={filled ? (isBest ? 'var(--accent)' : 'var(--bg-soft)') : 'transparent'}
                stroke={filled ? (isBest ? 'var(--accent)' : 'var(--border)') : 'var(--border)'}
                stroke-width="1"
                stroke-dasharray={filled ? '0' : '2 2'}
                opacity={filled ? 1 : 0.4} />
            );
          })}
        </g>
      );
    })}

    <text x={x0 - 8} y={top + maxQ * (cellH + gap) + 42} text-anchor="start" class="axttl dim">O(1) index access · … slots continue to 99¢</text>
  </svg>
  <figcaption>For bids, a bounded 1–99¢ price range makes each price level an array index. The highest populated level is the best bid. When it empties, the cursor scans backward through the small fixed range. The ask side is the mirror image.</figcaption>
</figure>

<style>
  .chart :global(.cent) { font-size: 12px; fill: var(--muted); font-family: var(--font-mono); }
  .chart :global(.cent.best) { fill: var(--accent); font-weight: 600; }
  .chart :global(.axttl) { font-size: 11px; fill: var(--muted); font-family: var(--font-sans); }
  .chart :global(.axttl.dim) { font-size: 10.5px; }
  .chart :global(.cursor) { font-size: 11px; fill: var(--accent); font-family: var(--font-mono); font-weight: 600; }
  .chart :global(.scan) { font-size: 10px; fill: var(--accent); font-family: var(--font-mono); }
</style>
