---
interface Props {
  /** absolute or root-relative URL to copy */
  url: string;
}
const { url } = Astro.props;
---
<button type="button" class="share-btn" data-copy={url} aria-label="Copy link" title="Copy link">
  <svg class="icon-share" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
    <path d="M12 3v12" />
    <path d="M8 7l4-4 4 4" />
  </svg>
  <svg class="icon-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
    <path d="M20 6 9 17l-5-5" />
  </svg>
</button>

<script>
  const w = window as unknown as { __shareInit?: boolean };
  if (!w.__shareInit) {
    w.__shareInit = true;
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.share-btn');
      if (!btn) return;
      const raw = btn.getAttribute('data-copy') || location.pathname;
      const full = new URL(raw, location.origin).href;
      try {
        await navigator.clipboard.writeText(full);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = full;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const share = btn.querySelector<SVGElement>('.icon-share');
      const check = btn.querySelector<SVGElement>('.icon-check');
      btn.classList.add('copied');
      if (share && check) {
        share.hidden = true;
        check.hidden = false;
      }
      setTimeout(() => {
        btn.classList.remove('copied');
        if (share && check) {
          share.hidden = false;
          check.hidden = true;
        }
      }, 1500);
    });
  }
</script>
