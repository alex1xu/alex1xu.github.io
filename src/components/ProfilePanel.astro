---
// One CPU-profile snapshot from the hunt, rendered as a small horizontal bar chart of the
// top self-time categories (real numbers from the folded perf captures at that stage). Each
// round in the post drops one of these into the section that discusses it, so the profile
// sits next to the prose that reads it. `stage` selects which snapshot; `caption` is optional
// (most panels self-label via the header + note and don't need one).
interface Props { stage: 'fanout' | 'runtime' | 'journal' | 'clone'; caption?: string; }
const { stage, caption } = Astro.props;

const STAGES = {
  fanout: {
    when: 'at the start', top: 'market-data fan-out',
    note: 'one broadcast + frame per trade, to 250 clients',
    bars: [
      { n: 'MD broadcast + refcount', p: 20, hot: true },
      { n: 'WS send', p: 11 },
      { n: 'runtime / scheduler', p: 11 },
      { n: 'reliable-lane encode', p: 0.4, guess: true },
    ],
  },
  runtime: {
    when: 'after batching MD', top: 'async-runtime tax',
    note: 'the routing thread is 92% runtime overhead, 8% work',
    bars: [
      { n: 'tokio scheduler + clock', p: 43, hot: true },
      { n: 'epoll + waking 250 tasks', p: 27 },
      { n: 'actual routing work', p: 8 },
    ],
  },
  journal: {
    when: 'after leaving the runtime', top: 'the engine, at 100% — doing nothing',
    note: 'spinning on an empty ring; the real cost is a thread asleep on disk',
    bars: [
      { n: 'engine spin (empty ring)', p: 45, hot: true, lie: true },
      { n: 'engine actual matching', p: 2.5 },
      { n: 'journal fsync (off-CPU)', p: 0, off: true },
    ],
  },
  clone: {
    when: 'after decoupling the journal', top: 'per-event clone + alloc',
    note: 'cloning each message into a replay buffer under a lock',
    bars: [
      { n: 'engine spin (waiting)', p: 22.9, lie: true },
      { n: 'clone into replay buffer', p: 14.7, hot: true },
      { n: 'allocator churn', p: 5.6, hot: true },
      { n: 'WS socket write', p: 1.5 },
    ],
  },
} as const;

const s = STAGES[stage];
const rowW = 640, barTrack = 300, labelW = 210, barH = 15, rowGap = 6;
const H = 30 + s.bars.length * (barH + rowGap) + 10;
const maxP = 45;
---
<figure class="chart ppanel">
  <div class="ppanel-head">
    <span class="ppanel-when">{s.when}</span>
    <span class="ppanel-arrow">→</span>
    <span class="ppanel-top">{s.top}</span>
  </div>
  <div class="ppanel-note">{s.note}</div>
  <svg viewBox={`0 0 ${rowW} ${H - 40}`} role="img" aria-label={`${s.when}: the top cost is ${s.top}. ${s.note}`}>
    {s.bars.map((b, j) => {
      const y = j * (barH + rowGap) + 4;
      const w = ('off' in b && b.off) ? 0 : (Math.min(b.p, maxP) / maxP) * barTrack;
      const guess = 'guess' in b && b.guess;
      const off = 'off' in b && b.off;
      const color = b.hot ? 'var(--accent)' : ('lie' in b && b.lie) ? 'var(--warning)' : guess ? 'var(--warning)' : 'var(--muted)';
      return (
        <g>
          <text x={labelW - 8} y={y + barH / 2 + 4} text-anchor="end" class={b.hot ? 'lbl hot' : 'lbl'}>{b.n}</text>
          {off
            ? <text x={labelW + 4} y={y + barH / 2 + 4} class="offcpu">off-CPU — no sample</text>
            : <rect x={labelW} y={y} width={Math.max(w, 2)} height={barH} rx="2" fill={color} opacity={guess ? 0.55 : 1} />}
          {!off && <text x={labelW + Math.max(w, 2) + 6} y={y + barH / 2 + 4} class="val">{b.p}%{guess ? ' — my guess' : ''}</text>}
        </g>
      );
    })}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ppanel { margin: 1.5rem 0; }
  .ppanel .ppanel-head { display: flex; align-items: baseline; gap: 0.45rem; flex-wrap: wrap; }
  .ppanel .ppanel-when { font-size: 11px; color: var(--muted); font-family: var(--font-mono); }
  .ppanel .ppanel-arrow { color: var(--muted); }
  .ppanel .ppanel-top { font-size: 14px; font-weight: 600; color: var(--fg); font-family: var(--font-sans); }
  .ppanel .ppanel-note { font-size: 11.5px; color: var(--muted); font-family: var(--font-sans); margin: 0.1rem 0 0.35rem; }
  .ppanel :global(.lbl) { font-size: 11.5px; fill: var(--fg); font-family: var(--font-sans); }
  .ppanel :global(.lbl.hot) { font-weight: 600; }
  .ppanel :global(.val) { font-size: 11px; fill: var(--muted); font-family: var(--font-mono); }
  .ppanel :global(.offcpu) { font-size: 11px; fill: var(--warning); font-family: var(--font-mono); font-style: italic; }
</style>
