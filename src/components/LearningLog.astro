---
import learning from '../data/learning.json';

type Status = 'done' | 'upcoming';
interface Link { label: string; url: string; }
interface Entry {
  date: string; endDate?: string; title: string;
  status: Status; phase?: string; repo?: string; links?: Link[]; blog?: string;
}
const entries = learning as Entry[];

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTH_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const WEEKDAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

const fmt = (d: string) => { const [,m,day] = d.split('-').map(Number); return `${MONTHS[m-1]} ${day}`; };
// A task may span several days; show "Jul 27 – 28" (drop the month on the end when unchanged).
const fmtRange = (e: Entry) => {
  if (!e.endDate || e.endDate === e.date) return fmt(e.date);
  const sameMonth = e.date.slice(0,7) === e.endDate.slice(0,7);
  return `${fmt(e.date)} – ${sameMonth ? e.endDate.split('-')[2].replace(/^0/,'') : fmt(e.endDate)}`;
};

const upcoming = entries.filter(e => e.status === 'upcoming').sort((a,b) => a.date < b.date ? -1 : 1);
const done     = entries.filter(e => e.status === 'done').sort((a,b) => a.date > b.date ? -1 : 1);
const listEntries = [...upcoming, ...done];

// ── Calendar: expand each entry across the weekdays it spans ──
// UTC helpers keep the day arithmetic off the server's local timezone.
const DAY = 86400000;
const toUTC = (s: string) => Date.parse(s + 'T00:00:00Z');
const isoOf = (t: number) => new Date(t).toISOString().slice(0, 10);
const isWeekend = (t: number) => { const g = new Date(t).getUTCDay(); return g === 0 || g === 6; };
function spanDays(e: Entry): string[] {
  const end = toUTC(e.endDate ?? e.date);
  const days: string[] = [];
  for (let t = toUTC(e.date); t <= end; t += DAY) if (!isWeekend(t)) days.push(isoOf(t));
  return days;
}

// coverage: every weekday a task touches → the tasks active that day (with edge markers)
interface Cover { entry: Entry; isStart: boolean; isEnd: boolean; }
const coverage = new Map<string, Cover[]>();
for (const e of entries) {
  const days = spanDays(e);
  days.forEach((d, i) => {
    const l = coverage.get(d) ?? [];
    l.push({ entry: e, isStart: i === 0, isEnd: i === days.length - 1 });
    coverage.set(d, l);
  });
}

const monthKeys = [...new Set([...coverage.keys()].map(d => d.slice(0,7)))].sort();
const months = monthKeys.map(key => {
  const [y,m] = key.split('-').map(Number);
  const cells: (number|null)[] = [];
  for (let i = 0; i < new Date(Date.UTC(y,m-1,1)).getUTCDay(); i++) cells.push(null);
  for (let d = 1; d <= new Date(Date.UTC(y,m,0)).getUTCDate(); d++) cells.push(d);
  return { key, label: `${MONTH_FULL[m-1]} ${y}`, cells };
});
const cellDate = (k: string, d: number) => `${k}-${String(d).padStart(2,'0')}`;
const cellStatus = (cs: Cover[]): Status => cs.some(c => c.entry.status === 'upcoming') ? 'upcoming' : 'done';

// Serialise entry data for popover (strip to what JS needs), keyed by each covered day
const popoverData = Object.fromEntries(
  [...coverage.entries()].map(([date, cs]) => [
    date,
    cs.map(c => ({ title: c.entry.title, range: fmtRange(c.entry), phase: c.entry.phase ?? '', links: c.entry.links ?? [] }))
  ])
);
---
<div class="log" data-initial="5" data-step="10" data-popover={JSON.stringify(popoverData)}>
  <div class="log-bar">
    <div class="log-views">
      <button type="button" class="log-view is-active" data-view="list">List</button>
      <button type="button" class="log-view" data-view="calendar">Calendar</button>
    </div>
    <div class="log-filters">
      <button type="button" class="log-tab is-active" data-filter="upcoming">Upcoming</button>
      <button type="button" class="log-tab" data-filter="done">Done</button>
    </div>
    <div class="log-legend">
      <span><i class="dot upcoming"></i>Upcoming</span>
      <span><i class="dot done"></i>Done</span>
    </div>
  </div>

  <!-- List view -->
  <div class="log-panel" data-panel="list">
    <ol class="log-list">
      {listEntries.map(e => (
        <li class="log-entry" data-group={e.status}>
          <div class="log-date">{fmtRange(e)}</div>
          <div class="log-body">
            <div class="log-head">
              <i class:list={['dot', e.status]}></i>
              <span class="log-title">{e.title}</span>
            </div>
            {e.phase && <div class="log-phase">{e.phase}</div>}
            {/* repo chip disabled — add a `repo` field to an entry and uncomment to show it:
                {e.repo && <a class="log-repo" href={`https://github.com/${e.repo}`} target="_blank" rel="noopener noreferrer">↗ {e.repo}</a>} */}
            {e.links && e.links.length > 0 && (
              <ul class="log-links">
                {e.links.map(l => (
                  <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
                ))}
              </ul>
            )}
            {e.blog && <a class="log-link" href={`/blog/${e.blog}`}>Read the write-up →</a>}
          </div>
        </li>
      ))}
    </ol>
    <div class="log-actions">
      <button type="button" class="log-more" hidden>Show more</button>
      <button type="button" class="log-less" hidden>Show less</button>
    </div>
  </div>

  <!-- Calendar view — one month at a time, arrows step between months -->
  <div class="log-panel" data-panel="calendar" hidden>
    <div class="cal-nav">
      <button type="button" class="cal-arrow" data-cal-nav="prev" aria-label="Previous month">◀</button>
      <span class="cal-nav-label" aria-live="polite"></span>
      <button type="button" class="cal-arrow" data-cal-nav="next" aria-label="Next month">▶</button>
    </div>
    {months.map((mo, i) => (
      <div class="cal-block" data-month={mo.key} hidden={i !== 0}>
        <div class="cal-grid">
          {WEEKDAYS.map(w => <div class="cal-weekday">{w}</div>)}
          {mo.cells.map(day => {
            if (day === null) return <div class="cal-cell empty"></div>;
            const cs = coverage.get(cellDate(mo.key, day));
            if (!cs) return <div class="cal-cell"><span class="day-num">{day}</span></div>;
            const s = cellStatus(cs);
            const dateKey = cellDate(mo.key, day);
            const isStart = cs.some(c => c.isStart);
            const isEnd = cs.some(c => c.isEnd);
            return (
              <div class:list={['cal-cell', 'has-entry', `s-${s}`, isStart && 'span-start', isEnd && 'span-end', !isStart && !isEnd && 'span-mid']}
                   data-date={dateKey}
                   tabindex="0" role="button" aria-label={cs.map(c=>c.entry.title).join(', ')}>
                <span class="day-num"><i class:list={['dot', s]}></i>{day}</span>
                {isStart && <span class="cell-label">{cs.filter(c=>c.isStart).map(c=>c.entry.title).join(' · ')}</span>}
              </div>
            );
          })}
        </div>
      </div>
    ))}
    <!-- popover element (hidden, positioned by JS) -->
    <div class="cal-popover" hidden aria-live="polite"></div>
  </div>
</div>

<script>
document.querySelectorAll<HTMLElement>('.log').forEach(log => {
  const initial = Number(log.dataset.initial) || 5;
  const step = Number(log.dataset.step) || 10;
  const entries = Array.from(log.querySelectorAll<HTMLElement>('.log-entry'));
  const viewBtns = Array.from(log.querySelectorAll<HTMLButtonElement>('.log-view'));
  const filterBtns = Array.from(log.querySelectorAll<HTMLButtonElement>('.log-tab'));
  const panels = Array.from(log.querySelectorAll<HTMLElement>('.log-panel'));
  const filters = log.querySelector<HTMLElement>('.log-filters')!;
  const moreBtn = log.querySelector<HTMLButtonElement>('.log-more')!;
  const lessBtn = log.querySelector<HTMLButtonElement>('.log-less')!;
  const popoverEl = log.querySelector<HTMLElement>('.cal-popover')!;
  const popoverData: Record<string, Array<{title:string; range:string; phase:string; links:{label:string;url:string}[]}>> =
    JSON.parse(log.dataset.popover || '{}');

  // Calendar month paging
  const monthBlocks = Array.from(log.querySelectorAll<HTMLElement>('.cal-block'));
  const monthKeys = monthBlocks.map(b => b.dataset.month!);
  const navLabel = log.querySelector<HTMLElement>('.cal-nav-label');
  const navPrev = log.querySelector<HTMLButtonElement>('[data-cal-nav="prev"]');
  const navNext = log.querySelector<HTMLButtonElement>('[data-cal-nav="next"]');
  // Default to the current month if it has entries, else the nearest month that does.
  const todayKey = new Date().toISOString().slice(0, 7);
  let monthIdx = (() => {
    const exact = monthKeys.indexOf(todayKey);
    if (exact !== -1) return exact;
    const after = monthKeys.findIndex(k => k >= todayKey);
    return after === -1 ? monthKeys.length - 1 : after;
  })();

  let view = 'list', filter = 'upcoming', shown = initial;

  // ── List render ──────────────────────────────────────────
  function renderList() {
    // Separate matching from non-matching first, then decide visibility.
    const matching = entries.filter(el => el.dataset.group === filter);
    const visible  = matching.slice(0, shown);
    const visibleSet = new Set(visible);

    entries.forEach(el => { el.style.display = visibleSet.has(el) ? '' : 'none'; });

    const remaining = matching.length - visible.length;
    moreBtn.hidden = remaining <= 0;
    if (!moreBtn.hidden) moreBtn.textContent = `Show ${Math.min(step, remaining)} more`;
    lessBtn.hidden = visible.length <= initial;
    filterBtns.forEach(t => t.classList.toggle('is-active', t.dataset.filter === filter));
  }

  // ── View toggle ─────────────────────────────────────────
  function renderView() {
    panels.forEach(p => (p.hidden = p.dataset.panel !== view));
    viewBtns.forEach(b => b.classList.toggle('is-active', b.dataset.view === view));
    filters.style.display = view === 'list' ? '' : 'none';
    if (view !== 'calendar') closePopover();
  }

  // ── Calendar month paging ────────────────────────────────
  const MONTH_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  function monthLabelFor(key: string) {
    const [y, m] = key.split('-').map(Number);
    return `${MONTH_FULL[m - 1]} ${y}`;
  }
  function renderMonth() {
    closePopover();
    monthBlocks.forEach((b, i) => (b.hidden = i !== monthIdx));
    if (navLabel) navLabel.textContent = monthLabelFor(monthKeys[monthIdx]);
    if (navPrev) navPrev.disabled = monthIdx === 0;
    if (navNext) navNext.disabled = monthIdx === monthBlocks.length - 1;
  }

  // ── Calendar popover ─────────────────────────────────────
  let openCell: HTMLElement | null = null;

  function buildPopoverHTML(date: string) {
    const items = popoverData[date];
    if (!items || items.length === 0) return '';
    return items.map(item => {
      const linksHtml = item.links.length
        ? `<ul class="pop-links">${item.links.map(l =>
            `<li><a href="${l.url}" target="_blank" rel="noopener noreferrer">${l.label}</a></li>`
          ).join('')}</ul>`
        : '';
      const meta = [item.range, item.phase].filter(Boolean).join(' · ');
      return `<div class="pop-item"><strong>${item.title}</strong>${meta ? `<div class="pop-phase">${meta}</div>` : ''}${linksHtml}</div>`;
    }).join('');
  }

  function openPopover(cell: HTMLElement) {
    const date = cell.dataset.date;
    if (!date) return;
    const html = buildPopoverHTML(date);
    if (!html) return;
    popoverEl.innerHTML = html;
    popoverEl.hidden = false;
    cell.classList.add('popped');
    openCell = cell;
    // Position below the cell
    const cr = cell.getBoundingClientRect();
    const lr = log.getBoundingClientRect();
    const top = cr.bottom - lr.top + 6;
    const left = Math.min(cr.left - lr.left, lr.width - 280);
    popoverEl.style.top = `${top}px`;
    popoverEl.style.left = `${Math.max(0, left)}px`;
  }

  function closePopover() {
    popoverEl.hidden = true;
    popoverEl.innerHTML = '';
    if (openCell) { openCell.classList.remove('popped'); openCell = null; }
  }

  // Click on cell: toggle popover
  log.addEventListener('click', e => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (!cell) { if (!popoverEl.contains(e.target as Node)) closePopover(); return; }
    if (openCell === cell) { closePopover(); return; }
    closePopover();
    openPopover(cell);
  });

  // Keyboard: Enter/Space opens, Escape closes
  log.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePopover(); return; }
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (cell && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openCell === cell ? closePopover() : (closePopover(), openPopover(cell)); }
  });

  // Hover: open on enter, close on leave (skip on touch)
  let isTouchDevice = false;
  window.addEventListener('touchstart', () => { isTouchDevice = true; }, { once: true });
  log.addEventListener('mouseenter', e => {
    if (isTouchDevice) return;
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (cell && cell !== openCell) { closePopover(); openPopover(cell); }
  }, true);
  log.addEventListener('mouseleave', e => {
    if (isTouchDevice) return;
    const to = e.relatedTarget as HTMLElement | null;
    if (to && (log.contains(to))) return;
    closePopover();
  }, true);

  // ── Wire up ──────────────────────────────────────────────
  viewBtns.forEach(b => b.addEventListener('click', () => { view = b.dataset.view!; renderView(); }));
  filterBtns.forEach(t => t.addEventListener('click', () => { filter = t.dataset.filter!; shown = initial; renderList(); }));
  moreBtn.addEventListener('click', () => { shown += step; renderList(); });
  lessBtn.addEventListener('click', () => {
    shown = initial; renderList();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    log.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  });
  navPrev?.addEventListener('click', () => { if (monthIdx > 0) { monthIdx--; renderMonth(); } });
  navNext?.addEventListener('click', () => { if (monthIdx < monthBlocks.length - 1) { monthIdx++; renderMonth(); } });
  renderView();
  renderList();
  renderMonth();
});
</script>
