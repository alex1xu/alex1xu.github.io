---
import learning from '../data/learning.json';

type Status = 'done' | 'upcoming';
interface Link { label: string; url: string; }
interface Entry {
  date: string; title: string; items?: string[];
  status: Status; phase?: string; repo?: string; links?: Link[]; blog?: string;
}
const entries = learning as Entry[];

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTH_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const WEEKDAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

const fmt = (d: string) => { const [,m,day] = d.split('-').map(Number); return `${MONTHS[m-1]} ${day}`; };

const upcoming = entries.filter(e => e.status === 'upcoming').sort((a,b) => a.date < b.date ? -1 : 1);
const done     = entries.filter(e => e.status === 'done').sort((a,b) => a.date > b.date ? -1 : 1);
const listEntries = [...upcoming, ...done];

// Calendar
const byDate = new Map<string, Entry[]>();
for (const e of entries) { const l = byDate.get(e.date) ?? []; l.push(e); byDate.set(e.date, l); }
const monthKeys = [...new Set(entries.map(e => e.date.slice(0,7)))].sort();
const months = monthKeys.map(key => {
  const [y,m] = key.split('-').map(Number);
  const cells: (number|null)[] = [];
  for (let i = 0; i < new Date(y,m-1,1).getDay(); i++) cells.push(null);
  for (let d = 1; d <= new Date(y,m,0).getDate(); d++) cells.push(d);
  return { key, label: `${MONTH_FULL[m-1]} ${y}`, cells };
});
const cellDate = (k: string, d: number) => `${k}-${String(d).padStart(2,'0')}`;
const cellStatus = (es: Entry[]): Status => es.some(e => e.status === 'upcoming') ? 'upcoming' : 'done';

// Serialise entry data for popover (strip to what JS needs)
const popoverData = Object.fromEntries(
  [...byDate.entries()].map(([date, es]) => [
    date,
    es.map(e => ({ title: e.title, phase: e.phase ?? '', links: e.links ?? [] }))
  ])
);
---
<div class="log" data-initial="5" data-popover={JSON.stringify(popoverData)}>
  <div class="log-bar">
    <div class="log-views">
      <button type="button" class="log-view is-active" data-view="list">List</button>
      <button type="button" class="log-view" data-view="calendar">Calendar</button>
    </div>
    <div class="log-filters">
      <button type="button" class="log-tab is-active" data-filter="upcoming">Upcoming</button>
      <button type="button" class="log-tab" data-filter="done">Done</button>
    </div>
    <div class="log-legend">
      <span><i class="dot upcoming"></i>Upcoming</span>
      <span><i class="dot done"></i>Done</span>
    </div>
  </div>

  <!-- List view -->
  <div class="log-panel" data-panel="list">
    <ol class="log-list">
      {listEntries.map(e => (
        <li class="log-entry" data-group={e.status}>
          <div class="log-date">{fmt(e.date)}</div>
          <div class="log-body">
            <div class="log-head">
              <i class:list={['dot', e.status]}></i>
              <span class="log-title">{e.title}</span>
            </div>
            {e.phase && <div class="log-phase">{e.phase}</div>}
            {/* repo chip disabled — add a `repo` field to an entry and uncomment to show it:
                {e.repo && <a class="log-repo" href={`https://github.com/${e.repo}`} target="_blank" rel="noopener noreferrer">↗ {e.repo}</a>} */}
            {e.links && e.links.length > 0 && (
              <ul class="log-links">
                {e.links.map(l => (
                  <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
                ))}
              </ul>
            )}
            {e.blog && <a class="log-link" href={`/blog/${e.blog}`}>Read the write-up →</a>}
          </div>
        </li>
      ))}
    </ol>
    <button type="button" class="log-more" hidden>Show more</button>
  </div>

  <!-- Calendar view -->
  <div class="log-panel" data-panel="calendar" hidden>
    {months.map(mo => (
      <div class="cal-block">
        <div class="cal-label">{mo.label}</div>
        <div class="cal-grid">
          {WEEKDAYS.map(w => <div class="cal-weekday">{w}</div>)}
          {mo.cells.map(day => {
            if (day === null) return <div class="cal-cell empty"></div>;
            const es = byDate.get(cellDate(mo.key, day));
            if (!es) return <div class="cal-cell"><span class="day-num">{day}</span></div>;
            const s = cellStatus(es);
            const dateKey = cellDate(mo.key, day);
            return (
              <div class={`cal-cell has-entry s-${s}`} data-date={dateKey}
                   tabindex="0" role="button" aria-label={es.map(e=>e.title).join(', ')}>
                <span class="day-num"><i class:list={['dot', s]}></i>{day}</span>
                <span class="cell-label">{es.map(e=>e.title).join(' · ')}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))}
    <!-- popover element (hidden, positioned by JS) -->
    <div class="cal-popover" hidden aria-live="polite"></div>
  </div>
</div>

<script>
document.querySelectorAll<HTMLElement>('.log').forEach(log => {
  const initial = Number(log.dataset.initial) || 4;
  const entries = Array.from(log.querySelectorAll<HTMLElement>('.log-entry'));
  const viewBtns = Array.from(log.querySelectorAll<HTMLButtonElement>('.log-view'));
  const filterBtns = Array.from(log.querySelectorAll<HTMLButtonElement>('.log-tab'));
  const panels = Array.from(log.querySelectorAll<HTMLElement>('.log-panel'));
  const filters = log.querySelector<HTMLElement>('.log-filters')!;
  const moreBtn = log.querySelector<HTMLButtonElement>('.log-more')!;
  const popoverEl = log.querySelector<HTMLElement>('.cal-popover')!;
  const popoverData: Record<string, Array<{title:string; phase:string; links:{label:string;url:string}[]}>> =
    JSON.parse(log.dataset.popover || '{}');

  let view = 'list', filter = 'upcoming', expanded = false;

  // ── List render ──────────────────────────────────────────
  function renderList() {
    // Separate matching from non-matching first, then decide visibility.
    const matching = entries.filter(el => el.dataset.group === filter);
    const visible  = expanded ? matching : matching.slice(0, initial);
    const visibleSet = new Set(visible);

    entries.forEach(el => { el.style.display = visibleSet.has(el) ? '' : 'none'; });

    const remaining = matching.length - visible.length;
    moreBtn.hidden = remaining <= 0;
    if (!moreBtn.hidden) moreBtn.textContent = `Show ${remaining} more`;
    filterBtns.forEach(t => t.classList.toggle('is-active', t.dataset.filter === filter));
  }

  // ── View toggle ─────────────────────────────────────────
  function renderView() {
    panels.forEach(p => (p.hidden = p.dataset.panel !== view));
    viewBtns.forEach(b => b.classList.toggle('is-active', b.dataset.view === view));
    filters.style.display = view === 'list' ? '' : 'none';
    if (view !== 'calendar') closePopover();
  }

  // ── Calendar popover ─────────────────────────────────────
  let openCell: HTMLElement | null = null;

  function buildPopoverHTML(date: string) {
    const items = popoverData[date];
    if (!items || items.length === 0) return '';
    return items.map(item => {
      const linksHtml = item.links.length
        ? `<ul class="pop-links">${item.links.map(l =>
            `<li><a href="${l.url}" target="_blank" rel="noopener noreferrer">${l.label}</a></li>`
          ).join('')}</ul>`
        : '';
      return `<div class="pop-item"><strong>${item.title}</strong>${item.phase ? `<div class="pop-phase">${item.phase}</div>` : ''}${linksHtml}</div>`;
    }).join('');
  }

  function openPopover(cell: HTMLElement) {
    const date = cell.dataset.date;
    if (!date) return;
    const html = buildPopoverHTML(date);
    if (!html) return;
    popoverEl.innerHTML = html;
    popoverEl.hidden = false;
    cell.classList.add('popped');
    openCell = cell;
    // Position below the cell
    const cr = cell.getBoundingClientRect();
    const lr = log.getBoundingClientRect();
    const top = cr.bottom - lr.top + 6;
    const left = Math.min(cr.left - lr.left, lr.width - 280);
    popoverEl.style.top = `${top}px`;
    popoverEl.style.left = `${Math.max(0, left)}px`;
  }

  function closePopover() {
    popoverEl.hidden = true;
    popoverEl.innerHTML = '';
    if (openCell) { openCell.classList.remove('popped'); openCell = null; }
  }

  // Click on cell: toggle popover
  log.addEventListener('click', e => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (!cell) { if (!popoverEl.contains(e.target as Node)) closePopover(); return; }
    if (openCell === cell) { closePopover(); return; }
    closePopover();
    openPopover(cell);
  });

  // Keyboard: Enter/Space opens, Escape closes
  log.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePopover(); return; }
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (cell && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openCell === cell ? closePopover() : (closePopover(), openPopover(cell)); }
  });

  // Hover: open on enter, close on leave (skip on touch)
  let isTouchDevice = false;
  window.addEventListener('touchstart', () => { isTouchDevice = true; }, { once: true });
  log.addEventListener('mouseenter', e => {
    if (isTouchDevice) return;
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-date]');
    if (cell && cell !== openCell) { closePopover(); openPopover(cell); }
  }, true);
  log.addEventListener('mouseleave', e => {
    if (isTouchDevice) return;
    const to = e.relatedTarget as HTMLElement | null;
    if (to && (log.contains(to))) return;
    closePopover();
  }, true);

  // ── Wire up ──────────────────────────────────────────────
  viewBtns.forEach(b => b.addEventListener('click', () => { view = b.dataset.view!; renderView(); }));
  filterBtns.forEach(t => t.addEventListener('click', () => { filter = t.dataset.filter!; expanded = false; renderList(); }));
  moreBtn.addEventListener('click', () => { expanded = true; renderList(); });
  renderView();
  renderList();
});
</script>
