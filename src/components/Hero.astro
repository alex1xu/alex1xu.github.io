---
interface Props {
  /** which nav item is active: 'home' | 'about' | 'blog' */
  page?: string;
}
const { page = 'home' } = Astro.props;
---
<header class="hero">
  <a href="/" class="hero-name">Alexander Xu</a>
  <div class="hero-links">
    <a href="https://www.linkedin.com/in/alexanderyxu/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
    <a href="https://x.com/alex1xu" target="_blank" rel="me noopener noreferrer">Twitter</a>
    <a href="mailto:alexander.xu@berkeley.edu">Email</a>
  </div>
  <nav class="hero-nav">
    <a href="/" class:list={[{ active: page === 'home' }]}>Home</a>
    <a href="/about" class:list={[{ active: page === 'about' }]}>About</a>
    <a href="/blog" class:list={[{ active: page === 'blog' }]}>Blog</a>
  </nav>
</header>
