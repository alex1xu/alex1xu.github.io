---
interface Props {
  name: string;
  alt: string;
  caption: string;
}

const { name, alt, caption } = Astro.props;
---

<figure class="excalidraw-diagram">
  <img src={`/diagrams/${name}.svg`} alt={alt} loading="lazy" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .excalidraw-diagram { margin: 2rem 0; }
  .excalidraw-diagram img { width: 100%; height: auto; display: block; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); }
  .excalidraw-diagram figcaption { margin-top: 0.65rem; font-size: 0.92rem; color: var(--muted); line-height: 1.5; }
</style>
